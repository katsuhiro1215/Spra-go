# Spra Go 用の Caddy(外向き。HTTPS の証明書を自動で取って更新する)。
# 画面(Next.js)と API(Laravel / PHP-FPM)を、ホスト名で振り分ける。
# ドメインは環境変数(compose.prod.yaml が渡す)。本番: go.spra.jp / api.go.spra.jp
# 手元の予行演習では http://localhost:3100 / http://localhost:8081 にして、HTTPS を使わない。
{
	email {$CADDY_ACME_EMAIL:admin@example.com}
}

{$WEB_SITE:go.spra.jp} {
	encode gzip

	reverse_proxy next:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}

{$API_SITE:api.go.spra.jp} {
	encode gzip

	# php_fastcgi は public/index.php の有無をこの Caddy 側で見るので、app と同じパスに public を置いてある(Dockerfile.prod の web)
	root * /var/www/html/public

	request_body {
		max_size 2MB
	}

	php_fastcgi app:9000 {
		read_timeout 30s
	}

	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
