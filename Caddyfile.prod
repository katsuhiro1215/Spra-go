# Spra Go 用の内側の Caddy(web コンテナ)。TLS は本体の Caddy が終端するので、ここは HTTP の :80 のみ。
# 本体 Caddy(reverse_proxy spra-go-web:80)→ この Caddy → php-fpm(spra-go-app:9000)の順に渡る。
{
	auto_https off
	servers {
		# 本体 Caddy(プライベートアドレス)の X-Forwarded-* を上書きせず、そのまま php-fpm に渡す。
		# 無いと、利用者のIPが本体 Caddy のIPに置き換わり、回数制限が全員まとめて数えられる
		trusted_proxies static private_ranges
	}
}

:80 {
	# app コンテナと同じパスにする(php_fastcgi の SCRIPT_FILENAME がそのまま解決される)
	root * /var/www/html/public

	request_body {
		max_size 2MB
	}

	# 素の `app` は本体と紛れるので、別名 spra-go-app で呼ぶ(2026-10-08 の障害の教訓)
	php_fastcgi spra-go-app:9000 {
		read_timeout 30s
	}

	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
