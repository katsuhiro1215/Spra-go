# Spra Go 本番の環境変数の見本。サーバーにだけ .env.production としてコピーして埋める(gitに入れない・権限 600)。
# 値を変えたら、コンテナを作り直す: docker compose --env-file .env.production -f compose.prod.yaml up -d --force-recreate
# (再起動だけでは反映されない。docs/design/2026-10-10-production-env-design.md 9章)

APP_NAME="Spra Go"
APP_ENV=production
# php artisan key:generate --show で作った値を入れる
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.go.spra.jp
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

# 画面(Next.js)の場所。CORS・メールのリンクの行き先
FRONTEND_URL=https://go.spra.jp
SANCTUM_STATEFUL_DOMAINS=go.spra.jp
SESSION_DOMAIN=.go.spra.jp
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=120

# 画面のビルドに埋め込まれる値(ビルドのときに読む)
NEXT_PUBLIC_API_URL=https://api.go.spra.jp
NEXT_PUBLIC_SITE_URL=https://go.spra.jp

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_HOST=spra-go-mysql
DB_PORT=3306
DB_DATABASE=spra_go
DB_USERNAME=spra_go
# openssl rand -base64 24 で作る。チャットやコミットに残さない
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database

# メール(登録の確認・パスワードの再設定)。まずは Xserver のメールアカウントで始める
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
# ポート465なら smtps、587なら空
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@spra.jp
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@spra.jp
MAIL_FROM_NAME="Spra Go"

# 保護者のご意見を送る、中央管理システム(Spra)のお問い合わせAPI。どれかが空なら送らない
SPRA_CONTACT_API_URL=
SPRA_CONTACT_API_KEY=
SPRA_CONTACT_CATEGORY_ID=

# コイン購入は、限定公開のあいだ使わない(公開設定のスイッチもOFF)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
