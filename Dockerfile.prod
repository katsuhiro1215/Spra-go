# syntax=docker/dockerfile:1
#
# Spra Go 本番用ビルド(docs/design/2026-10-10-production-env-design.md 4章)。
# 既存のLightsail(本体 projects/Spra と同居)に、別のComposeプロジェクト「spra-go」として載せる。
# ターゲット: app(Laravel / PHP-FPM) / web(内側のCaddy。Laravelの public を配り、PHP-FPMへ渡す) / next(Next.js)

########################################
# PHP の依存(本番用。開発ツールは入れない)
########################################
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./
# 依存の解決だけを行う段階なので、拡張のチェックは無視する(実際の拡張は app 側で入れる)
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs

COPY . .
RUN composer dump-autoload --optimize --no-dev --classmap-authoritative

########################################
# Laravel(PHP-FPM)
########################################
FROM php:8.5-fpm-alpine AS app

# opcache は PHP 8.5 から本体に組み込み済み(docker-php-ext-install すると失敗する)
RUN docker-php-ext-install -j"$(nproc)" pdo_mysql

RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.memory_consumption=64'; \
    } > /usr/local/etc/php/conf.d/opcache-prod.ini \
    && { \
        echo 'memory_limit=192M'; \
        echo 'expose_php=Off'; \
        echo 'date.timezone=UTC'; \
    } > /usr/local/etc/php/conf.d/app.ini \
    && { \
        echo '[www]'; \
        echo 'pm = ondemand'; \
        echo 'pm.max_children = 5'; \
        echo 'pm.process_idle_timeout = 20s'; \
    } > /usr/local/etc/php-fpm.d/zz-spra-go.conf

WORKDIR /var/www/html

COPY . .
COPY --from=vendor /app/vendor ./vendor

# 開発機のパッケージ一覧(bootstrap/cache)は持ち込まず(.dockerignore)、本番の vendor(--no-dev)から作り直す。
# 持ち込むと、入っていない開発用パッケージのプロバイダを探して起動に失敗する
RUN mkdir -p bootstrap/cache && php artisan package:discover --ansi

RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

USER www-data

EXPOSE 9000

CMD ["php-fpm"]

########################################
# 内側の Caddy(HTTP の :80 のみ。HTTPS は本体の Caddy が終端する)
########################################
# php_fastcgi は public/index.php の有無を Caddy 側で見るので、app と同じパスに public を置く
FROM caddy:2-alpine AS web

WORKDIR /var/www/html

COPY --from=app /var/www/html/public ./public
COPY Caddyfile.prod /etc/caddy/Caddyfile

########################################
# Next.js(standalone)
########################################
FROM node:22-alpine AS next-build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# NEXT_PUBLIC_* はビルドのときに画面のコードへ埋め込まれる。本番の値で作る
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=1024

RUN npm run build

FROM node:22-alpine AS next

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S nextjs && adduser -S nextjs -G nextjs

COPY --from=next-build --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=next-build --chown=nextjs:nextjs /app/.next/static ./.next/static
COPY --from=next-build --chown=nextjs:nextjs /app/public ./public

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
